{
  "name": "@demolition-labs/server",
  "version": "0.1.0",
  "private": true,
  "description": "DemolitionLabs authoritative game server — uWebSockets.js + 20 Hz tick loop",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@demolition-labs/engine": "workspace:*",
    "dotenv": "^18.0.4",
    "kafkajs": "^2.2.4",
    "prom-client": "^15.1.3",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.48.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^2.0.0"
  }
}
