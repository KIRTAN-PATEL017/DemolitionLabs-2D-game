FROM node:20-slim AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@9

# Copy the entire monorepo
COPY . .

# Install all dependencies (required for monorepo linking)
RUN pnpm install --frozen-lockfile

# Build the engine and the server
RUN pnpm --filter @demolition-labs/engine build
RUN pnpm --filter @demolition-labs/server build

# Production image
FROM node:20-slim AS runner

WORKDIR /app

# We still need pnpm to run the workspace script
RUN npm install -g pnpm@9

# Copy everything from builder
COPY --from=builder /app /app

ENV NODE_ENV=production

# PORT is intentionally NOT hardcoded here.
# Cloud Run injects its own PORT env variable at runtime (default: 8080).
# The server reads process.env.PORT and binds to it dynamically.

CMD ["pnpm", "--filter", "@demolition-labs/server", "start"]
